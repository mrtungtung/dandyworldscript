local function tpToNearestCategory(cat)
    local char = player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local closest, dist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and classifyItem(obj) == cat then
            local adornee = getAdornee(obj)
            if adornee then
                local d = (adornee.Position - myRoot.Position).Magnitude
                if d < dist then closest, dist = adornee, d end
            end
        end
    end
    if closest then
        myRoot.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0))
        toast("TP → nearest " .. cat, P_MAIN)
    else
        toast("No " .. cat .. " found", P_RED)
    end
end

