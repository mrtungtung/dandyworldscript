local lastFPSUpdate = tick()
local frameCount = 0
local fpsAccum = 0
local currentFPS = 60

runService.RenderStepped:Connect(function(dt)
    if hudEnabled then
        hudFrame.Visible = true
        frameCount = frameCount + 1
        fpsAccum = fpsAccum + dt
        if tick() - lastFPSUpdate >= 0.5 then
            currentFPS = math.floor(frameCount / fpsAccum)
            hudFPS.Text = tostring(currentFPS)
            if currentFPS >= 55 then hudFPS.TextColor3 = Color3.fromRGB(100, 220, 120)
            elseif currentFPS >= 30 then hudFPS.TextColor3 = Color3.fromRGB(230, 200, 80)
            else hudFPS.TextColor3 = Color3.fromRGB(230, 90, 90) end
            frameCount = 0
            fpsAccum = 0
            lastFPSUpdate = tick()
            if watermarkEnabled then
                watermarkLabel.Text = string.format("◆ SAFE PLAY · v23 · %d FPS", currentFPS)
            end
            if dashStatFPS then dashStatFPS.Text = tostring(currentFPS) end
        end
    else
        hudFrame.Visible = false
    end

    if not flyEnabled and (forceSpeed or sprinting) then applyCurrentSpeed() end

    if flyEnabled and flyVelocity and flyAlign then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or flyVelocity.Parent ~= root or flyAlign.Parent ~= root then
            startFly()
        else
            local moveDir = Vector3.zero
            if uis:IsKeyDown(Enum.KeyCode.W) then moveDir += camera.CFrame.LookVector end
            if uis:IsKeyDown(Enum.KeyCode.S) then moveDir -= camera.CFrame.LookVector end
            if uis:IsKeyDown(Enum.KeyCode.A) then moveDir -= camera.CFrame.RightVector end
            if uis:IsKeyDown(Enum.KeyCode.D) then moveDir += camera.CFrame.RightVector end
            if uis:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
            if uis:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end
            if moveDir.Magnitude > 0 then
                flyVelocity.VectorVelocity = moveDir.Unit * flySpeed
            else
                flyVelocity.VectorVelocity = Vector3.zero
            end
            flyAlign.CFrame = camera.CFrame
        end
    end
end)

runService.Heartbeat:Connect(function()
    local now = tick()

    if autoHealEnabled and humanoid and humanoid.Parent and humanoid.Health < humanoid.MaxHealth then
        humanoid.Health = humanoid.MaxHealth
    end
    if autoJumpEnabled and humanoid and humanoid.Parent and humanoid.FloorMaterial ~= Enum.Material.Air then
        humanoid.Jump = true
    end
    if bhopEnabled and humanoid and humanoid.Parent and humanoid.FloorMaterial ~= Enum.Material.Air then
        humanoid.Jump = true
    end
    if autoSprint and humanoid and humanoid.Parent then
        local moving = humanoid.MoveDirection.Magnitude > 0.1
        if moving and not sprinting then sprinting = true; applyCurrentSpeed()
        elseif not moving and sprinting then sprinting = false; applyCurrentSpeed() end
    end
    if autoPhaseEnabled and now - autoPhaseLast > 0.5 then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
            local speed = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z).Magnitude
            if speed <= 2 then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { char }
                local dir = humanoid.MoveDirection
                dir = Vector3.new(dir.X, 0, dir.Z).Unit
                local hit = workspace:Raycast(hrp.Position, dir * 3, params)
                if hit then
                    if phaseThroughWall() then autoPhaseLast = now end
                end
            end
        end
    end

    -- Safety (throttled)
    if safetyAntiFling and now - safetyLastFling > 0.25 then
        safetyLastFling = now
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, v in pairs(hrp:GetChildren()) do
                if v:IsA("BodyAngularVelocity") or v:IsA("BodyForce") or v:IsA("AngularVelocity") then
                    v:Destroy()
                end
            end
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
    if safetyAntiFling2 and now - safetyLastFling2 > 0.2 then
        safetyLastFling2 = now
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local v = hrp.AssemblyLinearVelocity
            if v.Magnitude > 500 then
                hrp.AssemblyLinearVelocity = v.Unit * 250
            end
        end
    end
    if safetyAntiVoid and now - safetyLastVoid > 0.3 then
        safetyLastVoid = now
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if hrp.Position.Y < safetyAntiVoidY then
                if safetyLastPos then
                    hrp.CFrame = CFrame.new(safetyLastPos.X, safetyLastPos.Y + 5, safetyLastPos.Z)
                    toast("Anti-Void: returned", P_RED)
                else
                    hrp.CFrame = CFrame.new(hrp.Position.X, 100, hrp.Position.Z)
                end
            elseif hrp.Position.Y > safetyAntiVoidY + 20 then
                safetyLastPos = hrp.Position
            end
        end
    end
    if safetyAntiDrag and now - safetyLastDrag > 0.2 then
        safetyLastDrag = now
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if safetyDragLast then
                local dist = (hrp.Position - safetyDragLast).Magnitude
                if dist > 35 and not flyEnabled then
                    hrp.CFrame = CFrame.new(safetyDragLast)
                    toast("Anti-Drag: reverted", P_RED)
                end
            end
            safetyDragLast = hrp.Position
        end
    end
    if safetyAntiFreeze and now - safetyLastFreeze > 0.5 then
        safetyLastFreeze = now
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed < 1 and not sprinting and not forceSpeed then
            hum.WalkSpeed = walkSpeedVal
        end
    end

    if espAutoRefresh and now - espLastAuto >= espAutoInterval then
        espLastAuto = now
        fullScan()
    end

    if now - espLastLabel >= espLabelInterval then
        espLastLabel = now
        refreshESPLabels()
    end
end)

