local function createTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = P_BTN
    btn.BorderSizePixel = 0
    btn.Text = name
    btn.TextColor3 = P_TEXT
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = sideScroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local p = Instance.new("UIPadding", btn); p.PaddingLeft = UDim.new(0, 12)

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 0, 0)
    accent.Position = UDim2.new(0, 6, 0.5, 0)
    accent.BackgroundColor3 = P_MAIN
    accent.BorderSizePixel = 0
    accent.Visible = false
    accent.Parent = btn
    Instance.new("UICorner", accent).CornerRadius = UDim.new(1, 0)

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.Parent = contentScroll

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 7)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    tabs[name] = { button = btn, container = container, accent = accent }
    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.container.Visible = false
            tween:Create(t.button, TweenInfo.new(0.15), { BackgroundColor3 = P_BTN }):Play()
            tween:Create(t.button, TweenInfo.new(0.15), { TextColor3 = P_TEXT }):Play()
            t.accent.Visible = false
            tween:Create(t.accent, TweenInfo.new(0.15), { Size = UDim2.new(0, 3, 0, 0) }):Play()
        end
        container.Visible = true
        tween:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = P_MAIN }):Play()
        tween:Create(btn, TweenInfo.new(0.15), { TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
        accent.Visible = true
        tween:Create(accent, TweenInfo.new(0.2), { Size = UDim2.new(0, 3, 0, 22) }):Play()
        activeTab = name
    end)
    if not activeTab then
        container.Visible = true
        btn.BackgroundColor3 = P_MAIN
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        accent.Visible = true
        accent.Size = UDim2.new(0, 3, 0, 22)
        activeTab = name
    end
    return container
end

