-- Returns true ONLY if the instance name contains "monster"
local function nameHasMonster(inst)
    if not inst or not inst.Name then return false end
    return inst.Name:lower():find(TWISTED_KEYWORD, 1, true) ~= nil
end

-- STRICT: isNPC returns true ONLY for objects with "monster" in the name.
-- No more "any model with humanoid" auto-classification.
local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    if plrs:GetPlayerFromCharacter(model) then return false end
    if model == player.Character then return false end
    -- STRICT check: name must contain "monster"
    return nameHasMonster(model)
end

local function getAdornee(model)
    if model:IsA("BasePart") then return model end
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart")
end

local function nameMatchesAnywhere(inst, list)
    if not inst or not inst.Name then return false end
    local n = inst.Name:lower()
    for _, b in ipairs(ITEM_BLACKLIST) do if n == b then return false end end
    for _, kw in ipairs(list) do
        if n:find(kw, 1, true) then return true end
    end
    if inst:IsA("Model") or inst:IsA("Folder") then
        for _, c in ipairs(inst:GetChildren()) do
            if c.Name then
                local cn = c.Name:lower()
                local bl = false
                for _, b in ipairs(ITEM_BLACKLIST) do
                    if cn == b then bl = true; break end
                end
                if not bl then
                    for _, kw in ipairs(list) do
                        if cn:find(kw, 1, true) then return true end
                    end
                end
            end
        end
    end
    return false
end

local function classifyItem(inst)
    if not inst or not inst.Parent then return nil end
    if inst == player.Character then return nil end
    if inst:IsA("Model") and plrs:GetPlayerFromCharacter(inst) then return nil end
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then return nil end

    -- Skip anything that's classified as a Twisted (Monster name)
    if nameHasMonster(inst) then return nil end

    if nameMatchesAnywhere(inst, MACHINE_KEYWORDS) then return "machine" end
    if nameMatchesAnywhere(inst, HEAL_KEYWORDS) then return "heal" end
    if nameMatchesAnywhere(inst, ITEM_KEYWORDS) then return "item" end
    return nil
end

local function categoryColor(cat)
    if cat == "machine" then return espMachineColor end
    if cat == "heal"    then return espHealColor end
    if cat == "item"    then return espItemColor end
    if cat == "player"  then return espPlayerColor end
    if cat == "twisted" then return espTwistedColor end
    return Color3.new(1,1,1)
end

local function categoryEnabled(cat)
    if cat == "machine" then return espMachineEnabled end
    if cat == "heal"    then return espHealEnabled end
    if cat == "item"    then return espItemEnabled end
    if cat == "player"  then return espPlayerEnabled end
    if cat == "twisted" then return espTwistedEnabled end
    return false
end

local function makeESPBlock(model, category, color, labelName)
    if espCache[model] then return end
    local adornee = getAdornee(model)
    if not adornee then return end

    local sel = Instance.new("SelectionBox")
    sel.Name = "SafePlaySel"
    sel.Adornee = adornee
    sel.Color3 = color
    sel.LineThickness = 0.15
    sel.Transparency = 0.3
    sel.SurfaceTransparency = 1
    sel.SurfaceColor3 = color
    sel.Parent = adornee

    local hl
    if espUseHighlight and hlCount < maxHighlights then
        local hlTarget = model:IsA("Model") and model or adornee
        hl = Instance.new("Highlight")
        hl.Name = "SafePlayESP"
        hl.Adornee = hlTarget
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = 0.75
        hl.OutlineTransparency = 0.2
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = hlTarget
        hlCount = hlCount + 1
    end

    local box
    if espUseBox then
        box = Instance.new("BoxHandleAdornment")
        box.Name = "SafePlayBox"
        box.Adornee = adornee
        local extents = model:IsA("Model") and model:GetExtentsSize() or adornee.Size
        box.Size = extents + Vector3.new(0.5, 0.5, 0.5)
        box.AlwaysOnTop = true
        box.ZIndex = 5
        box.Transparency = 0.4
        box.Color3 = color
        box.Parent = adornee
    end

    local tag
    if nameTagEnabled or espShowDistance or espShowHealth then
        local head = model:FindFirstChild("Head") or adornee
        tag = Instance.new("BillboardGui")
        tag.Name = "SafePlayTag"
        tag.Size = UDim2.new(0, 160, 0, 40)
        tag.StudsOffset = Vector3.new(0, 3.5, 0)
        tag.AlwaysOnTop = true
        tag.Adornee = head
        tag.Parent = head

        local prefix = ""
        if category == "heal" then prefix = "[HP] "
        elseif category == "machine" then prefix = "[MCH] " end

        local shownName
        if category == "player" then
            shownName = labelName or model.Name
        elseif category == "twisted" then
            shownName = model.Name
        else
            shownName = getDisplayName(model)
        end

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Name = "NameLbl"
        nameLbl.Size = UDim2.new(1, 0, 0, 18)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = prefix .. shownName
        nameLbl.TextColor3 = color
        nameLbl.TextStrokeTransparency = 0
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 13
        nameLbl.Parent = tag

        local infoLbl = Instance.new("TextLabel")
        infoLbl.Name = "InfoLbl"
        infoLbl.Size = UDim2.new(1, 0, 0, 14)
        infoLbl.Position = UDim2.new(0, 0, 0, 18)
        infoLbl.BackgroundTransparency = 1
        infoLbl.Text = ""
        infoLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        infoLbl.TextStrokeTransparency = 0
        infoLbl.Font = Enum.Font.Gotham
        infoLbl.TextSize = 11
        infoLbl.Parent = tag
    end

    espCache[model] = {
        selection = sel, highlight = hl, box = box, tag = tag,
        category = category, color = color, adornee = adornee
    }
end

local function removeESPBlock(model)
    local data = espCache[model]
    if not data then return end
    if data.selection and data.selection.Parent then data.selection:Destroy() end
    if data.highlight and data.highlight.Parent then
        data.highlight:Destroy()
        hlCount = math.max(0, hlCount - 1)
    end
    if data.box and data.box.Parent then data.box:Destroy() end
    if data.tag and data.tag.Parent then data.tag:Destroy() end
    espCache[model] = nil
end

local function clearAllESP()
    for model in pairs(espCache) do removeESPBlock(model) end
    espCache = {}
    hlCount = 0
end

-- Full workspace scan
local function fullScan()
    -- Remove stale / disabled
    for model, data in pairs(espCache) do
        if not model.Parent then
            removeESPBlock(model)
        elseif not categoryEnabled(data.category) then
            removeESPBlock(model)
        end
    end

    -- Players
    if espPlayerEnabled then
        for _, p in pairs(plrs:GetPlayers()) do
            if p ~= player and p.Character then
                if not espCache[p.Character] then
                    makeESPBlock(p.Character, "player", espPlayerColor, p.Name)
                end
            end
        end
    end

    -- Count for item cap
    local itemCount = 0
    for _, data in pairs(espCache) do
        if data.category ~= "player" and data.category ~= "twisted" then
            itemCount = itemCount + 1
        end
    end

    -- Scan workspace — STRICT
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not espCache[obj] then
            local monsterName = nameHasMonster(obj)

            -- Twisted: ONLY if name contains "monster"
            if espTwistedEnabled and monsterName and (obj:IsA("Model") or obj:IsA("BasePart")) then
                makeESPBlock(obj, "twisted", espTwistedColor)
            elseif obj:IsA("BasePart") or obj:IsA("Model") then
                local cat = classifyItem(obj)
                if cat and categoryEnabled(cat) then
                    if itemCount < maxESPItems then
                        makeESPBlock(obj, cat, categoryColor(cat))
                        itemCount = itemCount + 1
                    end
                end
            end
        end
    end
end

local function refreshESPLabels()
    local char = player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for model, data in pairs(espCache) do
        if data.tag and data.tag.Parent then
            local infoLbl = data.tag:FindFirstChild("InfoLbl")
            if infoLbl then
                local root = data.adornee or model.PrimaryPart
                local bits = {}
                if root and espShowDistance then
                    bits[#bits+1] = string.format("%dm",
                        math.floor((root.Position - myRoot.Position).Magnitude))
                end
                if espShowHealth and model:IsA("Model") then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    if hum then
                        bits[#bits+1] = string.format("%d/%d",
                            math.floor(hum.Health), math.floor(hum.MaxHealth))
                    end
                end
                infoLbl.Text = table.concat(bits, " · ")
            end
        end
    end
end

