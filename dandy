    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = box

    box.Position = UDim2.new(1, 60, 0, 0)
    tween:Create(box, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0),
    }):Play()

    task.delay(2.5, function()
        local out = tween:Create(box, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 60, 0, 0),
            BackgroundTransparency = 1,
        })
        out:Play()
        out.Completed:Connect(function() box:Destroy() end)
    end)
end

