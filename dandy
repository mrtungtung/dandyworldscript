    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = P_MAIN; stroke.Thickness = 1; stroke.Transparency = 0.75
    local base = color or P_BTN
    btn.MouseEnter:Connect(function()
        tween:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = base:Lerp(P_MAIN, 0.3) }):Play()
    end)
    btn.MouseLeave:Connect(function()
        tween:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = base }):Play()
    end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

