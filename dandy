            if ok2 and cfg then
                if cfg.walkSpeed then walkSpeedVal = cfg.walkSpeed end
                if cfg.sprintSpeed then sprintSpeedVal = cfg.sprintSpeed end
                if cfg.flySpeed then flySpeed = cfg.flySpeed end
                applyCurrentSpeed()
                toast("Config loaded", P_GREEN)
            end
        end
    end
end, P_BLUE)

