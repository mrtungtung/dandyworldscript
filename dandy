local GENERIC = {
    model = true, part = true, meshpart = true,
    unionoperation = true, negatedoperation = true,
    folder = true, instance = true,
}

local function getDisplayName(inst)
    if not inst then return "?" end
    if inst.Name and inst.Name ~= "" and not GENERIC[inst.Name:lower()] then
        return inst.Name
    end
    for _, c in ipairs(inst:GetDescendants()) do
        if c:IsA("BasePart") or c:IsA("Model") then
            if c.Name and c.Name ~= "" and not GENERIC[c.Name:lower()] then
                return c.Name
            end
        end
    end
    return inst.Name or "?"
end

