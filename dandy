    end

    local names = {}
    for name in pairs(waypoints) do table.insert(names, name) end
    table.sort(names)

    local count = 0
    for _, name in ipairs(names) do
        local cf = waypoints[name]
        count = count + 1

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 34)
        row.BackgroundColor3 = P_BTN
        row.BorderSizePixel = 0
        row.Parent = waypointList
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -140, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = name
        lbl.TextColor3 = P_TEXT
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextTruncate = Enum.TextTruncate.AtEnd
        lbl.Parent = row

        local goBtn = Instance.new("TextButton")
        goBtn.Size = UDim2.new(0, 58, 1, 0)
        goBtn.Position = UDim2.new(1, -128, 0, 0)
        goBtn.BackgroundColor3 = P_GREEN
        goBtn.BorderSizePixel = 0
        goBtn.Text = "GO"
        goBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        goBtn.Font = Enum.Font.GothamBold
        goBtn.TextSize = 11
        goBtn.Parent = row
        Instance.new("UICorner", goBtn).CornerRadius = UDim.new(0, 6)
        goBtn.MouseButton1Click:Connect(function()
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = cf + Vector3.new(0, 3, 0)
                toast("TP → " .. name, P_MAIN)
            end
        end)

        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 58, 1, 0)
        delBtn.Position = UDim2.new(1, -64, 0, 0)
        delBtn.BackgroundColor3 = P_RED
        delBtn.BorderSizePixel = 0
        delBtn.Text = "DEL"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Font = Enum.Font.GothamBold
        delBtn.TextSize = 11
        delBtn.Parent = row
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 6)
        delBtn.MouseButton1Click:Connect(function()
            if waypoints[name] == cf then
                waypoints[name] = nil
                saveWaypointsToDisk()
                toast("Deleted: " .. name, P_RED)
                task.defer(refreshWaypointList)
            end
        end)
    end

    if count == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 30)
        empty.BackgroundTransparency = 1
        empty.Text = "(no waypoints saved yet)"
        empty.TextColor3 = P_TEXT_D
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 12
        empty.Parent = waypointList
    end
end

