local function phaseThroughWall()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if tick() - phaseCooldown < 0.3 then return false end

    local dir = humanoid and humanoid.MoveDirection or Vector3.zero
    if dir.Magnitude < 0.1 then dir = camera.CFrame.LookVector end
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then return false end
    dir = dir.Unit

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
    params.IgnoreWater = true

    local hit1 = workspace:Raycast(hrp.Position, dir * phaseDistance, params)
    if not hit1 then return false end

    local pastOrigin = hit1.Position + dir * 1.5
    local hit2 = workspace:Raycast(pastOrigin, dir * phaseDistance, params)

    local landingPos
    if hit2 then
        local gap = (hit2.Position - hit1.Position).Magnitude
        if gap < 3 then return false end
        landingPos = hit1.Position + dir * (gap / 2)
    else
        landingPos = hit1.Position + dir * 4
    end

    local checkUp = workspace:Raycast(landingPos, Vector3.new(0, 3, 0), params)
    if checkUp then return false end

    local floor = workspace:Raycast(landingPos, Vector3.new(0, -50, 0), params)
    local targetY = floor and (floor.Position.Y + 4) or landingPos.Y
    hrp.CFrame = CFrame.new(Vector3.new(landingPos.X, targetY, landingPos.Z))
    phaseCooldown = tick()
    return true
end

local function stopFly()
    if flyVelocity then flyVelocity:Destroy() flyVelocity = nil end
    if flyAlign then flyAlign:Destroy() flyAlign = nil end
    if flyAttachment then flyAttachment:Destroy() flyAttachment = nil end
    if humanoid and humanoid.Parent then humanoid.PlatformStand = false end
end

local function startFly()
    stopFly()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    hum.PlatformStand = true
    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "SafePlayFlyAttachment"
    flyAttachment.Parent = root
    flyAlign = Instance.new("AlignOrientation")
    flyAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyAlign.Attachment0 = flyAttachment
    flyAlign.MaxTorque = math.huge
    flyAlign.Responsiveness = 200
    flyAlign.RigidityEnabled = false
    flyAlign.Parent = root
    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.MaxForce = math.huge
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.Parent = root
end

local function currentTargetSpeed()
    return sprinting and sprintSpeedVal or walkSpeedVal
end

local function applyCurrentSpeed()
    if not humanoid or not humanoid.Parent then return end
    local target = currentTargetSpeed()
    if humanoid.WalkSpeed ~= target then humanoid.WalkSpeed = target end
end

local function attachSpeedGuard(hum)
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if flyEnabled then return end
        if forceSpeed or sprinting then
            local target = currentTargetSpeed()
            if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
        end
    end)
end
if humanoid then attachSpeedGuard(humanoid) end

local function applyCharacterScale(scale)
    local char = player.Character
    if not char then return end
    local ok = pcall(function() char:ScaleTo(scale) end)
    if not ok then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.BodyDepthScale.Value = scale
                hum.BodyHeightScale.Value = scale
                hum.BodyWidthScale.Value = scale
                hum.HeadScale.Value = scale
            end)
        end
    end
end

