-- WAYPOINT PERSISTENCE
-- ============================================================
local function loadWaypointsFromDisk()
    if not (readfile and isfile) then return end
    local ok, exists = pcall(isfile, WAYPOINT_FILE)
    if not ok or not exists then return end
    local rok, raw = pcall(readfile, WAYPOINT_FILE)
    if not rok or not raw then return end
    local jok, data = pcall(function() return http:JSONDecode(raw) end)
    if not jok or type(data) ~= "table" then return end
    for name, pos in pairs(data) do
        if type(name) == "string" and type(pos) == "table"
           and pos.x and pos.y and pos.z then
            waypoints[name] = CFrame.new(pos.x, pos.y, pos.z)
        end
    end
end

local function saveWaypointsToDisk()
    if not writefile then return end
    local out = {}
    for name, cf in pairs(waypoints) do
        out[name] = { x = cf.X, y = cf.Y, z = cf.Z }
    end
    pcall(function()
        writefile(WAYPOINT_FILE, http:JSONEncode(out))
    end)
end

